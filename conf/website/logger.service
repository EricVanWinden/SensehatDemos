[Unit]
Description=Sense HAT Sensor Logger
After=multi-user.target

[Service]
Type=simple
WorkingDirectory=/home/pi/SensehatDemos
ExecStart=/home/pi/SensehatDemos/.venv/bin/python /home/pi/SensehatDemos/logger.py
User=pi
Group=pi
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
